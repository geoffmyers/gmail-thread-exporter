{
  "manifest_version": 3,
  "name": "Gmail Thread Exporter",
  "version": "1.0.1",
  "description": "Bulk export Gmail threads to PDF, HTML, Markdown, JSON, and EML formats",
  "author": "Geoff Myers",
  "homepage_url": "https://github.com/geoffmyers/gmail-thread-exporter",
  "key": "",

  "permissions": [
    "identity",
    "downloads",
    "storage",
    "offscreen",
    "debugger"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://www.googleapis.com/*"
  ],

  "oauth2": {
    "client_id": "634892303163-26o1dt2hoc51e06ajd82p81vet6th15r.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },

  "background": {
    "service_worker": "src/background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": [
        "src/content/gmail-dom.js",
        "src/content/export-modal.js",
        "src/content/gmail-injector.js"
      ],
      "css": ["src/content/gmail-exporter.css"],
      "run_at": "document_idle"
    }
  ],

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },

  "minimum_chrome_version": "109"
}
